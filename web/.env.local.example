# Copy this file to .env.local and fill in the values you want to enable.
# The app works without any of these — the related feature is just hidden/disabled.

# --- Google Drive sync (cross-device portfolio sync) ---
# 1. Go to https://console.cloud.google.com/ and create (or pick) a project.
# 2. APIs & Services > Library > enable "Google Drive API".
# 3. APIs & Services > OAuth consent screen > configure it (External is fine
#    for a public site; add your own Google account as a test user while
#    the app is unverified).
# 4. APIs & Services > Credentials > Create Credentials > OAuth client ID >
#    Application type: "Web application".
# 5. Under "Authorized JavaScript origins" add every origin you'll open the
#    site from, e.g. http://localhost:3000 and https://your-deployed-domain.com
#    (No redirect URI needed — this uses the GIS token popup flow.)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Site URL (used for canonical links, OG images, Facebook post links) ---
NEXT_PUBLIC_SITE_URL=

# --- Google Analytics 4 ---
# Create a Web data stream at https://analytics.google.com/ and copy its
# Measurement ID (G-XXXXXXXXXX). Skipped entirely if unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Pexels (free stock photos for article cover images) ---
# 1. Go to https://www.pexels.com/api/ and sign up (free, no card required).
# 2. Copy the API key from your Pexels API dashboard.
# Used only by the gold-news-writer agent (see .claude/agents/) when it
# searches for a cover image — not used by the running website itself.
PEXELS_API_KEY=

# --- Google Search Console API (service account, optional) ---
# 1. https://console.cloud.google.com/ → enable "Search Console API" on a project.
# 2. IAM & Admin > Service Accounts > create one > Keys tab > Add Key > JSON.
# 3. Add the service account's email as a user (Restricted is enough) at
#    https://search.google.com/search-console under Settings > Users and permissions.
# 4. Point this at the downloaded key file's path (keep it OUTSIDE the repo,
#    or make sure it's gitignored by name — never commit a service-account key).
# Used by scripts/search-console.mjs (sites/analytics/inspect subcommands) —
# not used by the running website itself.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# --- Facebook Page auto-post (optional) ---
# 1. Go to https://developers.facebook.com/ and create an app (type: "Business").
# 2. In Graph API Explorer (or via Facebook Login), request the
#    pages_manage_posts and pages_read_engagement permissions, select your
#    Page, and generate a Page Access Token.
# 3. Recommended: exchange it for a long-lived token (~60 days) via
#    https://developers.facebook.com/docs/facebook-login/guides/access-tokens#extending
#    — a plain Page token expires quickly. You'll need to refresh it
#    periodically; a System User token (needs Business Manager) doesn't expire.
# 4. Copy your Page's numeric ID (Page > About > Page transparency, or via
#    the Graph API Explorer) and the token below.
# Used only by the gold-news-writer agent when it auto-publishes an article
# — if unset, the agent skips the Facebook post (not an error).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
